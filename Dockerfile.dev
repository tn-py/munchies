FROM node:20-slim

# workerd (used by @astrojs/cloudflare dev server) needs libc++1; not available on Alpine
RUN apt-get update && apt-get install -y --no-install-recommends libc++1 && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy workspace manifests first for dependency layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ ./patches/

# Copy each app's package.json so pnpm can link the workspace
COPY apps/medusa-backend/package.json ./apps/medusa-backend/
COPY apps/web/package.json ./apps/web/
COPY apps/search/package.json ./apps/search/

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Source code is bind-mounted at runtime via docker-compose.
# Named volumes shadow node_modules so the host directory doesn't override installed deps.
